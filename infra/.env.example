# Copy to the repo root as .env (never commit .env). Safe dev defaults only; `make up` passes
# this file to docker compose, `make api` sources it for the API.

POSTGRES_USER=qarau
POSTGRES_PASSWORD=qarau_dev
POSTGRES_DB=qarau
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://qarau:qarau_dev@localhost:5433/qarau

# Versity S3 Gateway (ADR 0006): the container's root credentials and host port.
S3_PORT=7070
S3_ACCESS_KEY=qarau_dev_access
S3_SECRET_KEY=qarau_dev_secret

# Object storage for run artefacts (ADR 0024). The same code talks to Versity in dev and to
# the provider's S3 in the cloud: only these values change.
#   QARAU_S3_BUCKET   the bucket; EMPTY = storage off, every artefact lives under
#                     QARAU_RUNS_DIR only (the benchmark and the tests run that way).
#   QARAU_S3_ENDPOINT URL of the S3 service; leave empty for AWS S3.
#   QARAU_S3_REGION   signing region (any value for Versity).
# The pipeline worker and the API read the same five variables; the un-prefixed S3_ACCESS_KEY /
# S3_SECRET_KEY above are used when QARAU_S3_ACCESS_KEY / QARAU_S3_SECRET_KEY are unset.
QARAU_S3_ENDPOINT=http://localhost:7070
QARAU_S3_BUCKET=
QARAU_S3_ACCESS_KEY=qarau_dev_access
QARAU_S3_SECRET_KEY=qarau_dev_secret
QARAU_S3_REGION=us-east-1

# How /api/runs/{id}/manifest.json and /files/{path} answer when the file is not in the local
# cache: `stream` (default: the API streams the object; works with any CORS setup) or
# `redirect` (302 to a signed URL on the bucket, valid QARAU_SIGNED_URL_TTL_S seconds; the bucket
# must allow CORS from the web origin).
QARAU_FILES_MODE=stream
QARAU_SIGNED_URL_TTL_S=300

# Local run cache (relative to backend/, where `make api` runs). With storage on it is only a
# cache: `rm -rf data/runs/<run>` loses nothing.
QARAU_RUNS_DIR=../data/runs
# Empty = dev mode, no auth. Set to require "Authorization: Bearer <token>".
QARAU_API_TOKEN=
QARAU_CORS_ORIGINS=http://localhost:5173
