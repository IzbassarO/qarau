# Copy to devteam/.env (gitignored) and fill in. Never commit .env.
# Brain and tester (pay-per-use API): https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# dev_pipeline (your Claude subscription): run `claude setup-token` and paste the token
CLAUDE_CODE_OAUTH_TOKEN=
# Tester screenshots sign in with this user before shooting pages behind the A1b login (never
# printed: use a password longer than 8 characters so logs redact it). The dev server accepts
# any non-empty pair; against a real API the password is its Bearer token.
QARAU_TEST_USER=
QARAU_TEST_PASSWORD=
# Watchdog notifications by email (optional; without them only the macOS banner). Gmail: an app
# password, smtp.gmail.com, port 587.
DEVTEAM_NOTIFY_EMAIL=
DEVTEAM_SMTP_HOST=
DEVTEAM_SMTP_PORT=587
DEVTEAM_SMTP_USER=
DEVTEAM_SMTP_PASSWORD=
