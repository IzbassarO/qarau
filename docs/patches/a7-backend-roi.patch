diff --git a/backend/tests/test_roi.py b/backend/tests/test_roi.py
new file mode 100644
--- /dev/null
+++ b/backend/tests/test_roi.py
@@ -0,0 +1,283 @@
+import json
+import os
+from collections.abc import Iterator
+from pathlib import Path
+from typing import Any
+
+import pytest
+from fastapi.testclient import TestClient
+
+from app.main import app
+from app.settings import get_settings
+
+
+@pytest.fixture
+def catalog(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Iterator[Path]:
+    monkeypatch.setenv("QARAU_RUNS_DIR", str(tmp_path / "catalog"))
+    monkeypatch.setenv("QARAU_API_TOKEN", "")
+    get_settings.cache_clear()
+    app.dependency_overrides.clear()
+    yield tmp_path / "catalog"
+    app.dependency_overrides.clear()
+    get_settings.cache_clear()
+
+
+@pytest.fixture
+def client(catalog: Path) -> Iterator[TestClient]:
+    with TestClient(app) as test_client:
+        yield test_client
+
+
+@pytest.fixture
+def document() -> dict[str, Any]:
+    return {
+        "version": 1,
+        "site_id": "notre-dame",
+        "source_run": "inspection-1",
+        "frame": "reconstruction",
+        "up_axis": "z",
+        "min": [-1, -2, -3],
+        "max": [4, 5, 6],
+        "created_at": "2026-10-17T12:00:00.000Z",
+        "created_by": "engineer",
+    }
+
+
+def test_put_get_round_trip(client: TestClient, catalog: Path, document: dict[str, Any]) -> None:
+    saved = client.put("/api/sites/notre-dame/roi", json=document)
+    assert saved.status_code == 200
+    assert saved.json() == document
+    path = catalog / "sites" / "notre-dame" / "roi.json"
+    assert json.loads(path.read_text()) == document
+    # A fresh client loads from the catalog, independent of browser or process-local state.
+    with TestClient(app) as another_client:
+        loaded = another_client.get("/api/sites/notre-dame/roi")
+    assert loaded.status_code == 200
+    assert loaded.json() == document
+    assert loaded.headers["cache-control"] == "no-store"
+    assert saved.headers["cache-control"] == "no-store"
+
+
+def test_missing_region_returns_404(client: TestClient, catalog: Path) -> None:
+    response = client.get("/api/sites/no-region/roi")
+    assert response.status_code == 404
+    assert response.headers["cache-control"] == "no-store"
+    assert not catalog.exists()
+
+
+@pytest.mark.parametrize(
+    ("key", "value"),
+    [
+        ("version", 2),
+        ("version", True),
+        ("version", 1.0),
+        ("up_axis", "w"),
+        ("min", [0, 0]),
+        ("max", [0, 0, "infinity"]),
+        ("min", ["NaN", 0, 0]),
+        ("min", [False, 0, 0]),
+        ("min", [5, 0, 0]),
+        ("created_at", "not-a-date"),
+        ("created_at", "2026-10-17"),
+        ("created_at", "2026-10-17T12:00:00"),
+        ("created_at", "2026-02-30T12:00:00Z"),
+        ("source_run", ""),
+        ("frame", "   "),
+        ("created_by", ""),
+        ("site_id", "another-site"),
+        ("site_id", "../outside"),
+    ],
+)
+def test_invalid_body_returns_422(
+    client: TestClient, catalog: Path, document: dict[str, Any], key: str, value: object
+) -> None:
+    document[key] = value
+    assert client.put("/api/sites/notre-dame/roi", json=document).status_code == 422
+    assert not catalog.exists()
+
+
+def test_missing_field_and_malformed_json_return_422(
+    client: TestClient, document: dict[str, Any]
+) -> None:
+    del document["created_by"]
+    assert client.put("/api/sites/notre-dame/roi").status_code == 422
+    assert client.put("/api/sites/notre-dame/roi", json=document).status_code == 422
+    assert (
+        client.put(
+            "/api/sites/notre-dame/roi", content="{", headers={"Content-Type": "application/json"}
+        ).status_code
+        == 422
+    )
+
+
+@pytest.mark.parametrize("value", ["NaN", "Infinity", "-Infinity", "1e999"])
+def test_non_finite_numbers_return_422(
+    client: TestClient, document: dict[str, Any], value: str
+) -> None:
+    body = json.dumps(document).replace("[-1, -2, -3]", f"[{value}, -2, -3]")
+    assert (
+        client.put(
+            "/api/sites/notre-dame/roi", content=body, headers={"Content-Type": "application/json"}
+        ).status_code
+        == 422
+    )
+
+
+@pytest.mark.parametrize("method", ["GET", "PUT", "DELETE"])
+def test_every_route_requires_authentication(
+    client: TestClient,
+    monkeypatch: pytest.MonkeyPatch,
+    document: dict[str, Any],
+    method: str,
+) -> None:
+    monkeypatch.setenv("QARAU_API_TOKEN", "required-for-test")
+    get_settings.cache_clear()
+    assert client.request(method, "/api/sites/notre-dame/roi", json=document).status_code == 401
+    assert (
+        client.request(
+            method,
+            "/api/sites/notre-dame/roi",
+            json=document,
+            headers={"Authorization": "Bearer incorrect-for-test"},
+        ).status_code
+        == 401
+    )
+    response = client.request(
+        method,
+        "/api/sites/notre-dame/roi",
+        json=document,
+        headers={"Authorization": "Bearer required-for-test"},
+    )
+    assert response.status_code == {"GET": 404, "PUT": 200, "DELETE": 204}[method]
+
+
+@pytest.mark.parametrize(
+    "site_id",
+    ["%2e%2e", "..%2foutside", "a%2f..%2foutside", "a..b", "%5c..%5coutside", "%2foutside"],
+)
+@pytest.mark.parametrize("method", ["GET", "PUT", "DELETE"])
+def test_path_traversal_rejected(
+    client: TestClient, catalog: Path, document: dict[str, Any], site_id: str, method: str
+) -> None:
+    response = client.request(method, f"/api/sites/{site_id}/roi", json=document)
+    assert response.status_code == 400
+    assert not catalog.exists()
+
+
+def test_delete_is_persistent_and_idempotent(
+    client: TestClient, catalog: Path, document: dict[str, Any]
+) -> None:
+    assert client.put("/api/sites/notre-dame/roi", json=document).status_code == 200
+    deleted = client.delete("/api/sites/notre-dame/roi")
+    assert deleted.status_code == 204
+    assert deleted.content == b""
+    assert deleted.headers["cache-control"] == "no-store"
+    assert not (catalog / "sites" / "notre-dame" / "roi.json").exists()
+    assert client.get("/api/sites/notre-dame/roi").status_code == 404
+    assert client.delete("/api/sites/notre-dame/roi").status_code == 204
+
+
+def test_replace_is_atomic(
+    client: TestClient,
+    catalog: Path,
+    document: dict[str, Any],
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    assert client.put("/api/sites/notre-dame/roi", json=document).status_code == 200
+    path = catalog / "sites" / "notre-dame" / "roi.json"
+    previous = path.read_bytes()
+    replacement = {**document, "source_run": "inspection-2"}
+    replace = os.replace
+    replaced = False
+
+    def observed_replace(source: Path, target: Path) -> None:
+        nonlocal replaced
+        assert path.read_bytes() == previous
+        assert source.parent == target.parent == path.parent
+        assert json.loads(source.read_text()) == replacement
+        replace(source, target)
+        replaced = True
+
+    monkeypatch.setattr(os, "replace", observed_replace)
+    assert client.put("/api/sites/notre-dame/roi", json=replacement).status_code == 200
+    assert replaced
+    assert client.get("/api/sites/notre-dame/roi").json() == replacement
+    assert list(path.parent.iterdir()) == [path]
+
+
+@pytest.mark.parametrize("component", ["sites", "site", "file"])
+@pytest.mark.parametrize("method", ["GET", "PUT", "DELETE"])
+def test_symlinked_storage_rejected(
+    client: TestClient,
+    catalog: Path,
+    document: dict[str, Any],
+    component: str,
+    method: str,
+) -> None:
+    outside = catalog.parent / "outside"
+    outside.mkdir()
+    protected = outside / "roi.json"
+    protected.write_text(json.dumps(document))
+    catalog.mkdir()
+    if component == "sites":
+        (catalog / "sites").symlink_to(outside, target_is_directory=True)
+    elif component == "site":
+        (catalog / "sites").mkdir()
+        (catalog / "sites" / "notre-dame").symlink_to(outside, target_is_directory=True)
+    else:
+        directory = catalog / "sites" / "notre-dame"
+        directory.mkdir(parents=True)
+        (directory / "roi.json").symlink_to(protected)
+    before = protected.read_bytes()
+    assert client.request(method, "/api/sites/notre-dame/roi", json=document).status_code == 400
+    assert protected.read_bytes() == before
+
+
+def test_storage_error_preserves_previous_document_and_removes_temp_file(
+    client: TestClient,
+    catalog: Path,
+    document: dict[str, Any],
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    assert client.put("/api/sites/notre-dame/roi", json=document).status_code == 200
+
+    def failed_replace(source: Path, target: Path) -> None:
+        raise OSError("simulated unavailable storage")
+
+    monkeypatch.setattr(os, "replace", failed_replace)
+    failed = client.put("/api/sites/notre-dame/roi", json={**document, "source_run": "new-run"})
+    assert failed.status_code == 500
+    assert "could not save" in failed.json()["detail"]
+    assert client.get("/api/sites/notre-dame/roi").json() == document
+    assert [p.name for p in (catalog / "sites" / "notre-dame").iterdir()] == ["roi.json"]
+
+
+def test_corrupt_saved_document_is_an_error(client: TestClient, catalog: Path) -> None:
+    path = catalog / "sites" / "notre-dame" / "roi.json"
+    path.parent.mkdir(parents=True)
+    path.write_text("invalid json")
+    assert client.get("/api/sites/notre-dame/roi").status_code == 500
+
+
+def test_oversized_document_rejected(client: TestClient, document: dict[str, Any]) -> None:
+    assert (
+        client.put(
+            "/api/sites/notre-dame/roi", json={**document, "source_run": "r" * (64 * 1024)}
+        ).status_code
+        == 413
+    )
+
+
+@pytest.mark.parametrize("method", ["PUT", "DELETE"])
+def test_cors_allows_authenticated_roi_edits(client: TestClient, method: str) -> None:
+    response = client.options(
+        "/api/sites/notre-dame/roi",
+        headers={
+            "Origin": "http://localhost:5173",
+            "Access-Control-Request-Method": method,
+            "Access-Control-Request-Headers": "Authorization, Content-Type",
+        },
+    )
+    assert response.status_code == 200
+    assert response.headers["access-control-allow-origin"] == "http://localhost:5173"
+    assert method in response.headers["access-control-allow-methods"]
